{
  "name": "@chirag127/ndns",
  "version": "0.1.0",
  "exports": "./src/mod.ts",
  "nodeModulesDir": "auto",
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read --allow-write src/mod.ts",
    "check": "deno check src/mod.ts",
    "fmt": "deno fmt src/",
    "lint": "deno lint src/",
    "test": "deno test --allow-env --allow-read --allow-write tests/",
    "gen:site": "deno run --allow-env --allow-read --allow-write scripts/gen-site.ts",
    "compile:linux": "deno compile --target x86_64-unknown-linux-gnu --allow-net --allow-env --allow-read --allow-write -o dist/ndns-linux-x64 src/mod.ts",
    "compile:macos-arm": "deno compile --target aarch64-apple-darwin --allow-net --allow-env --allow-read --allow-write -o dist/ndns-macos-arm64 src/mod.ts",
    "compile:macos-x64": "deno compile --target x86_64-apple-darwin --allow-net --allow-env --allow-read --allow-write -o dist/ndns-macos-x64 src/mod.ts",
    "compile:windows": "deno compile --target x86_64-pc-windows-msvc --allow-net --allow-env --allow-read --allow-write -o dist/ndns-windows-x64.exe src/mod.ts"
  },
  "imports": {
    "@deno/gfm": "jsr:@deno/gfm@^0.12.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/cli": "jsr:@std/cli@^1.0.0",
    "@std/fmt": "jsr:@std/fmt@^1.0.0",
    "@std/csv": "jsr:@std/csv@^1.0.0"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "dom", "esnext"],
    "types": []
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
